{
  "name": "ethiopia-bids",
  "private": true,
  "type": "module",
  "workspaces": ["web", "mobile"],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "android": "npm run start -w mobile",
    "worker": "node --env-file-if-exists=.env lib/worker.mjs",
    "migrate": "node --env-file-if-exists=.env db/migrate.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {"pg": "^8.16.0"},
  "devDependencies": {"@electric-sql/pglite": "^0.3.0"}
}
