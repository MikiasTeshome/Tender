{
  "expo": {
    "name": "Fanos Tender",
    "icon": "./assets/fanos-tender-icon.png",
    "slug": "fanos-tender",
    "scheme": "fanostender",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.fanostender.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.fanostender.app"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/fanos-tender-icon.png",
          "color": "#1B4332"
        }
      ],
      "expo-secure-store"
    ]
  }
}
